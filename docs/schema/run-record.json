{
  "description": "A self-attesting record of one completed contract run.\n\nImmutable. Stamped with the schema version it was written under and\nthe digest of the contract that enforced it, so a persisted corpus\nof records can be re-validated offline (``scripts/check_run_records``)\nagainst the contracts that should have produced them.",
  "properties": {
    "completed_at": {
      "title": "Completed At",
      "type": "string"
    },
    "contract_digest": {
      "title": "Contract Digest",
      "type": "string"
    },
    "contract_name": {
      "title": "Contract Name",
      "type": "string"
    },
    "contract_version": {
      "title": "Contract Version",
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0.0,
      "title": "Duration Ms",
      "type": "number"
    },
    "outcome": {
      "enum": [
        "completed",
        "paused",
        "precondition",
        "invariant",
        "postcondition",
        "governance",
        "budget",
        "approval_denied"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "workload": {
      "title": "Workload",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "workload",
    "contract_name",
    "contract_version",
    "contract_digest",
    "outcome",
    "started_at",
    "completed_at",
    "duration_ms"
  ],
  "title": "RunRecord",
  "type": "object"
}
